{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["pac/**/*.ts", "mcp/**/*.ts", "slack/**/*.ts", "relay/**/*.ts", "explorer/**/*.ts", "hooks/**/*.ts", "dev/**/*.ts", "bin/**/*.ts", "tests/**/*.ts"]
}
